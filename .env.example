# Shell syntax. Replace placeholders before loading with: set -a; . ./.env; set +a
ESPHOME_NOISE_PSK='replace-with-your-firmware-api-encryption-key'
TALK_PREFER_XAI_OAUTH=true
GROK_EXPECTED_EMAIL='your-account@example.com'
# This acknowledges permission you have established; it does not grant permission.
GROK_ACCOUNT_AUTHORIZED=false
# Copy these three absolute paths from your Hermes sign-in setup (docs/provider.md).
HERMES_HOME='/path/to/private-hermes-data'
HERMES_SOURCE='/path/to/hermes-agent'
HERMES_PYTHON='/path/to/prepared-hermes-python3.14'
# Do not set XAI_API_KEY or TALK_XAI_API_KEY.
